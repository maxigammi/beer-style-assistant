# Скопируй в .env и заполни: cp .env.example .env
# .env в git не попадает.

# Telegram: токен от @BotFather
TELEGRAM_TOKEN=

# ОБЯЗАТЕЛЬНО. Telegram ID администраторов через запятую (свой ID покажет /myid).
# Админы всегда имеют доступ, создают инвайты (/invite) и могут запускать /ingest.
# Все остальные пользуются ботом только по инвайту.
ADMIN_IDS=

# OpenAI — эмбеддинги (поиск по базе)
OPENAI_API_KEY=
# Пусто = официальный api.openai.com. Для прокси, например ProxyAPI:
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_BASE_URL=

# GigaChat — генерация ответов
# Authorization Key из личного кабинета (base64 от client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# Кому показывать источники и отладочную строку (score, токены): off | admin | all
# Для реальных пользователей: admin (видишь только ты) или off.
SHOW_SOURCES=admin

# Сравнение стилей: добавлять ли короткую характеристику групп, написанную моделью (on/off).
# По умолчанию off: сравнение состоит только из чисел (считает код) и названий стилей.
# COMPARE_TRAITS=off

# Каталог изменяемого состояния (индекс и access.db). Пусто = data/ рядом с кодом.
# В Docker: путь смонтированного тома, например /state
# STATE_DIR=

# Порог релевантности поиска (косинусная близость 0..1)
# MIN_SCORE=0.25
