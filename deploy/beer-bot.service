# systemd-служба Beer Style Assistant. Установка: см. deploy/DEPLOY.md
[Unit]
Description=Beer Style Assistant (Telegram bot)
Wants=network-online.target
After=network-online.target
# Не уходить в бесконечный перезапуск при постоянной ошибке (например, неверный токен)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=beerbot
Group=beerbot
WorkingDirectory=/opt/beer-bot
# Секреты читает сам бот из /opt/beer-bot/.env (python-dotenv), в unit их нет
ExecStart=/opt/beer-bot/.venv/bin/python /opt/beer-bot/bot.py
Environment=PYTHONUNBUFFERED=1
# SIGINT: бот завершится штатно и запишет «Бот остановлен»
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=10

# Ограничения: писать можно только в каталог приложения (data/, bot.log)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/beer-bot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
